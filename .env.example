# Leave empty when the API is served under the same domain at /api
# (e.g. via a reverse proxy / platform rewrite).
# Set to the full API origin when hosting separately:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

# Paystack public key (safe to expose in the browser).
# VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
